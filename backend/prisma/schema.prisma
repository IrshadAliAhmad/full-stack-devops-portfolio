generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model PersonalInfo {
  id              Int      @id @default(autoincrement())
  name            String
  role            String
  email           String   @unique
  github          String?
  linkedin        String?
  profileImage    String?
  heroDescription String?
  about           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("personal_info")
}

model Project {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  githubUrl    String?
  liveUrl      String?
  techStack    String[]
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  displayOrder Int           @default(0)
  imageUrl     String?
  slug         String        @unique
  status       ProjectStatus @default(PUBLISHED)

  @@map("projects")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

enum Role {
  ADMIN
  USER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
